# Database Connection URI
MONGODB_URI=mongodb://localhost:27017/recapped

# Application URL Configurations
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
PORT=5000

# Crypto Encryption Key
# Generate a secure 32-character key for encryption/decryption at rest
NOTION_ENCRYPTION_KEY=some_secure_random_32_char_key_here

# Notion Workspace API Configuration
# Create an integration at https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:5000/api/integrations/notion/callback

# Slack Workspace API Configuration
# Create a Slack App at https://api.slack.com/apps
# Make sure to add the 'chat:write' and 'channels:read' bot scopes to your App.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must match exactly what is registered in the redirect URLs configuration inside the Slack App Dashboard
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/slack/callback

# Vercel Blob Storage Configuration
# Enable Vercel Blob on your project at Project Settings > Storage > Create Database > Blob.
# Paste the resulting BLOB_READ_WRITE_TOKEN value here.
BLOB_READ_WRITE_TOKEN=

# AI Agent LLM Provider Configuration
# Set AI_PROVIDER to "groq" or "gemini". Defaults to "groq" if unset.
AI_PROVIDER=groq
# If AI_PROVIDER is set to "gemini", obtain your free-tier API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Define the target Gemini model version to use (e.g. gemini-2.0-flash, gemini-2.5-flash). Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash


